// Nuki Planner — Prisma schema (realinhado à API de customização).
// Modelo relacional espelhando o núcleo da nk-api-customization em nomes
// PascalCase e ids Int autoincrement, para que a lógica compartilhada porte
// de forma limpa:
//   Enterprise → Room → RoomComponent → Material(opção → BaseMaterial)
//   Blueprint ⇄ Room via BlueprintRoom (M:N: room compartilhado entre plantas)
//   Catálogo: BaseMaterial (Type single|kit) + MaterialCategory + MaterialKitItem
//
// Divergências deliberadas da API (ver docs do plano):
//   - CUSTO fica no BaseMaterial (catálogo), "preenche 1x": CostMaterialInCents
//     + CostLaborInCents (Int? em centavos; NULL = pendente/sem custo). O catálogo
//     é escopado por Organization (não por Enterprise).
//   - Quantidade/RT variam POR PLANTA: BlueprintRoomComponent (a paleta de
//     produtos — RoomComponent + Material — é compartilhada; a quantidade não).
//   - Datas de exibição continuam String (*Label, verbatim "DD/MM/AAAA [HH:mm]").
//   - Preço de venda vivo vem do motor de fórmulas; Material.PriceInCents é só
//     snapshot de publicação.
//
// Tenancy: Organization/Membership são tabelas do planner (auth Supabase),
// mantidas com id String (uuid/slug). Toda entidade de empreendimento carrega
// EnterpriseId; o catálogo carrega OrganizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenancy / auth (planner-owned; id String) ──────────────────────────

model Organization {
  id            String             @id @default(uuid())
  name          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  members       Membership[]
  enterprises   Enterprise[]
  baseMaterials BaseMaterial[]
  categories    MaterialCategory[]
  mediaFiles    MediaFile[]
  mediaFolders  MediaFolder[]
  storageUsage  StorageUsage?

  @@map("organizations")
}

/// Liga um usuário do Supabase Auth (authUserId) a uma Organization.
model Membership {
  id             String       @id @default(uuid())
  authUserId     String       @map("auth_user_id")
  email          String
  role           String       @default("member")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([authUserId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ─── Enums (valores verbatim PT-BR; nomes de tipo em inglês) ────────────

enum PlanningStatus {
  rascunho
  em_preenchimento
  em_revisao
  publicado
}

enum BlueprintStatus {
  completa
  incompleta
}

enum CommentAuthor {
  construtora
  incorporadora
}

/// Como um componente de custo resolve seu preço unitário.
/// espelho = acompanha o material da opção; fixo = BaseMaterial próprio.
enum CostItemKind {
  espelho
  fixo
}

/// Lado do cálculo: crédito (padrão) ou débito (toda opção de upgrade).
enum CostItemSide {
  padrao
  upgrade
}

// ─── Enterprise (era Project) ───────────────────────────────────────────

model Enterprise {
  Id             Int            @id @default(autoincrement())
  OrganizationId String
  Name           String
  Developer      String? // incorporadora
  TowerLabel     String? // "torre" de exibição (texto livre)
  Status         PlanningStatus @default(rascunho)

  /// Datas de exibição verbatim ("DD/MM/AAAA" / "DD/MM/AAAA HH:mm").
  SubmittedAtLabel String?
  DeadlineLabel    String?
  PublishedAtLabel String?

  TotalItems  Int @default(0)
  FilledItems Int @default(0)

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  Organization   Organization    @relation(fields: [OrganizationId], references: [id], onDelete: Cascade)
  Blueprints     Blueprint[]
  Rooms          Room[]
  Materials      Material[]
  Towers         Tower[]
  UnitGroups     UnitGroup[]
  BudgetColumns  BudgetColumn[]
  BudgetVersions BudgetVersion[]
  Comments       Comment[]
  FillLinks      FillLink[]
  PortalFills    PortalFill[]

  @@index([OrganizationId])
}

// ─── Blueprint (era Tipologia) ──────────────────────────────────────────

model Blueprint {
  Id           Int             @id @default(autoincrement())
  EnterpriseId Int
  Name         String
  Description  String          @default("")
  AreaSqM      Float? // metragem
  UnitCount    Int             @default(0) // unidades
  Status       BlueprintStatus @default(incompleta)
  Position     Int             @default(0) // ordem

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  Enterprise     Enterprise      @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)
  BlueprintRooms BlueprintRoom[]

  @@index([EnterpriseId])
}

// ─── Room (era Ambiente; pertence ao Enterprise, compartilhado) ─────────

model Room {
  Id           Int     @id @default(autoincrement())
  EnterpriseId Int
  Name         String
  Icon         String?

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  Enterprise     Enterprise      @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)
  RoomComponents RoomComponent[]
  Materials      Material[]
  BlueprintRooms BlueprintRoom[]

  @@index([EnterpriseId])
}

// ─── BlueprintRoom (era AmbienteShared; M:N real + posição por planta) ──

model BlueprintRoom {
  Id          Int   @id @default(autoincrement())
  BlueprintId Int
  RoomId      Int
  Position    Int   @default(0)
  Polygon     Json? // RoomShape (rect/poly) — local na planta

  Blueprint  Blueprint                @relation(fields: [BlueprintId], references: [Id], onDelete: Cascade)
  Room       Room                     @relation(fields: [RoomId], references: [Id], onDelete: Cascade)
  Components BlueprintRoomComponent[]

  @@unique([BlueprintId, RoomId])
  @@index([BlueprintId])
  @@index([RoomId])
}

// ─── RoomComponent (era Componente; paleta COMPARTILHADA, sem quantidade) ─

model RoomComponent {
  Id                Int     @id @default(autoincrement())
  RoomId            Int
  Name              String
  Unit              String // unidade
  DefaultMaterialId Int? // → opção default (era padrao)
  IsGhost           Boolean @default(false) // ghost
  Position          Int     @default(0) // ordem

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  Room               Room                     @relation(fields: [RoomId], references: [Id], onDelete: Cascade)
  Options            Material[]               @relation("ComponentOptions")
  DefaultMaterial    Material?                @relation("DefaultOption", fields: [DefaultMaterialId], references: [Id], onDelete: SetNull)
  BlueprintInstances BlueprintRoomComponent[]
  CostItems          RoomComponentCostItem[]

  @@index([RoomId])
}

// ─── BlueprintRoomComponent (POR PLANTA: quantidade + reserva técnica) ──

model BlueprintRoomComponent {
  Id                  Int   @id @default(autoincrement())
  BlueprintRoomId     Int
  RoomComponentId     Int
  UsageQuantity       Float // qtd
  TechnicalReservePct Float @default(0) // rt (%)

  BlueprintRoom BlueprintRoom      @relation(fields: [BlueprintRoomId], references: [Id], onDelete: Cascade)
  RoomComponent RoomComponent      @relation(fields: [RoomComponentId], references: [Id], onDelete: Cascade)
  KitUsages     MaterialKitUsage[]
  CostUsages    CostItemUsage[]

  @@unique([BlueprintRoomId, RoomComponentId])
  @@index([BlueprintRoomId])
  @@index([RoomComponentId])
}

// ─── Material (opção por componente, COMPARTILHADA; era upgrades[]/padrao) ─

model Material {
  Id              Int     @id @default(autoincrement())
  RoomComponentId Int
  RoomId          Int // denormalizado (paridade API)
  EnterpriseId    Int // denormalizado (paridade API)
  BaseMaterialId  Int
  Position        Int     @default(0) // ordem entre opções
  IsDefault       Boolean @default(false)
  /// Snapshot de preço de venda (publicação); preço vivo vem da fórmula.
  PriceInCents    Int     @default(0)
  Name            String?

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  RoomComponent       RoomComponent   @relation("ComponentOptions", fields: [RoomComponentId], references: [Id], onDelete: Cascade)
  DefaultForComponent RoomComponent[] @relation("DefaultOption")
  Room                Room            @relation(fields: [RoomId], references: [Id], onDelete: Cascade)
  Enterprise          Enterprise      @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)
  BaseMaterial        BaseMaterial    @relation(fields: [BaseMaterialId], references: [Id], onDelete: Restrict)
  Comments            Comment[]

  @@unique([RoomComponentId, BaseMaterialId])
  @@index([RoomComponentId])
  @@index([BaseMaterialId])
  @@index([EnterpriseId])
}

// ─── BaseMaterial (catálogo; era Material + Kit) — por Organization ──────

model BaseMaterial {
  Id                  Int     @id @default(autoincrement())
  OrganizationId      String
  CategoryId          Int?
  Type                String  @default("single") // "single" | "kit"
  ReferenceCode       String // codigo
  Name                String
  Manufacturer        String? // fabricante (null p/ kit)
  Unit                String? // unidade (null p/ kit)
  /// Custo "preenche 1x". NULL = pendente (sem custo).
  CostMaterialInCents Int? // custoMat (centavos)
  CostLaborInCents    Int? // custoMO (centavos)
  /// URL legada — fallback quando MediaFileId é null (ver resolveMediaUrl).
  ImagePreviewUrl     String?
  MediaFileId         Int?

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  Organization Organization            @relation(fields: [OrganizationId], references: [id], onDelete: Cascade)
  Category     MaterialCategory?       @relation(fields: [CategoryId], references: [Id], onDelete: SetNull)
  MediaFile    MediaFile?              @relation("BaseMaterialPreviewMedia", fields: [MediaFileId], references: [Id], onDelete: SetNull)
  Options      Material[]
  KitItems     MaterialKitItem[]       @relation("KitParent")
  ParentKits   MaterialKitItem[]       @relation("KitChild")
  PortalFills  PortalFill[]
  CostItems    RoomComponentCostItem[] @relation("CostItemMaterial")

  @@index([OrganizationId])
  @@index([OrganizationId, Type])
  @@index([OrganizationId, CategoryId])
  @@index([MediaFileId])
}

model MaterialCategory {
  Id             Int      @id @default(autoincrement())
  OrganizationId String
  Name           String
  ColorScheme    String?
  CreatedAt      DateTime @default(now()) @db.Timestamptz()

  Organization  Organization   @relation(fields: [OrganizationId], references: [id], onDelete: Cascade)
  BaseMaterials BaseMaterial[]

  @@index([OrganizationId])
}

/// Composição do kit (era Kit.itens): sub-materiais de um BaseMaterial kit.
model MaterialKitItem {
  Id                   Int     @id @default(autoincrement())
  ParentMaterialId     Int
  ChildMaterialId      Int
  Position             Int     @default(0)
  Unit                 String? // unidade do sub-item (fallback: ChildMaterial.Unit)
  DefaultUsageQuantity Float?

  ParentMaterial BaseMaterial       @relation("KitParent", fields: [ParentMaterialId], references: [Id], onDelete: Cascade)
  ChildMaterial  BaseMaterial       @relation("KitChild", fields: [ChildMaterialId], references: [Id], onDelete: Restrict)
  Usages         MaterialKitUsage[]

  @@unique([ParentMaterialId, ChildMaterialId])
  @@index([ParentMaterialId])
}

/// Quantitativo de sub-item de kit POR PLANTA (era Componente.kitQtds).
model MaterialKitUsage {
  Id                       Int   @id @default(autoincrement())
  BlueprintRoomComponentId Int
  KitItemId                Int
  UsageQuantity            Float

  BlueprintRoomComponent BlueprintRoomComponent @relation(fields: [BlueprintRoomComponentId], references: [Id], onDelete: Cascade)
  KitItem                MaterialKitItem        @relation(fields: [KitItemId], references: [Id], onDelete: Cascade)

  @@unique([BlueprintRoomComponentId, KitItemId])
  @@index([BlueprintRoomComponentId])
}

// ─── Componente de custo ("satélite": SOLEIRA, RODAPÉ, RESERVA TÉCNICA) ──
//
// Linha somada ao custo do componente que NUNCA é ofertada na personalização.
// Espelha o par MaterialKitItem/MaterialKitUsage: definição compartilhada no
// RoomComponent + quantitativo por planta.

/// Definição do componente de custo — COMPARTILHADA entre plantas.
model RoomComponentCostItem {
  Id              Int          @id @default(autoincrement())
  RoomComponentId Int
  Name            String
  Kind            CostItemKind
  Side            CostItemSide @default(upgrade)
  /// BaseMaterial quando Kind = fixo; NULL quando espelho (segue a opção).
  BaseMaterialId  Int?
  Unit            String
  Position        Int          @default(0)

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  RoomComponent RoomComponent   @relation(fields: [RoomComponentId], references: [Id], onDelete: Cascade)
  /// Restrict: apagar um material usado como satélite zeraria o custo de troca
  /// de todas as opções do componente em silêncio.
  BaseMaterial  BaseMaterial?   @relation("CostItemMaterial", fields: [BaseMaterialId], references: [Id], onDelete: Restrict)
  Usages        CostItemUsage[]

  @@index([RoomComponentId])
  @@index([BaseMaterialId])
}

/// Quantitativo de componente de custo POR PLANTA (Componente.custoQtds).
model CostItemUsage {
  Id                       Int   @id @default(autoincrement())
  BlueprintRoomComponentId Int
  CostItemId               Int
  UsageQuantity            Float

  BlueprintRoomComponent BlueprintRoomComponent @relation(fields: [BlueprintRoomComponentId], references: [Id], onDelete: Cascade)
  CostItem               RoomComponentCostItem  @relation(fields: [CostItemId], references: [Id], onDelete: Cascade)

  @@unique([BlueprintRoomComponentId, CostItemId])
  @@index([BlueprintRoomComponentId])
}

// ─── Features só do planner (re-escopadas a Enterprise, ids Int) ────────

/// Coluna configurável do Construtor de Preço (fórmula por Name). Toda coluna
/// é livre: valor fixo ou "=fórmula". A soma por linha é a coluna fixa
/// "Total final", que não é configurável e não vive nesta tabela.
model BudgetColumn {
  Id           Int     @id @default(autoincrement())
  EnterpriseId Int
  Name         String
  Expr         String
  Visible      Boolean @default(false)
  Position     Int     @default(0)

  Enterprise Enterprise @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)

  @@index([EnterpriseId])
}

model BudgetVersion {
  Id             Int      @id @default(autoincrement())
  EnterpriseId   Int
  Label          String
  CreatedAtLabel String // "DD/MM/AAAA às HH:mm"
  CreatedBy      String
  IsCurrent      Boolean  @default(false)
  Summary        String
  Changes        Json
  Position       Int      @default(0)
  CreatedAt      DateTime @default(now()) @db.Timestamptz()

  Enterprise Enterprise @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)

  @@index([EnterpriseId])
}

/// Thread de comentário por opção de material (era rowKey compId-optId).
model Comment {
  Id           Int           @id @default(autoincrement())
  MaterialId   Int
  EnterpriseId Int
  Author       CommentAuthor
  AuthorName   String? // nome exibível de quem comentou (usuário logado / construtora)
  Text         String
  DateLabel    String // "DD/MM/AAAA HH:mm"
  CreatedAt    DateTime      @default(now()) @db.Timestamptz()

  Material   Material   @relation(fields: [MaterialId], references: [Id], onDelete: Cascade)
  Enterprise Enterprise @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)

  @@index([MaterialId])
  @@index([EnterpriseId])
}

// ─── Portal do terceiro (coleta de custo pela construtora) ──────────────

model FillLink {
  Id             Int      @id @default(autoincrement())
  EnterpriseId   Int
  Token          String   @unique
  BlueprintIds   Int[]    @default([]) // era tipologiaIds
  Fields         Json // FillLinkCampos {mat, mo, comment}
  DeadlineLabel  String? // prazo
  Password       String? // senha (plaintext no MVP)
  CreatedAtLabel String // "DD/MM/AAAA HH:mm"
  CreatedAt      DateTime @default(now()) @db.Timestamptz()

  Enterprise Enterprise @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)

  @@index([EnterpriseId])
}

/// Custo preenchido pela construtora no portal — vai para o BaseMaterial.
model PortalFill {
  EnterpriseId   Int
  BaseMaterialId Int
  Mat            String
  Mo             String
  Comment        String

  Enterprise   Enterprise   @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)
  BaseMaterial BaseMaterial @relation(fields: [BaseMaterialId], references: [Id], onDelete: Cascade)

  @@id([EnterpriseId, BaseMaterialId])
}

// ─── Torres / grupos de unidades ────────────────────────────────────────

model Tower {
  Id           Int    @id @default(autoincrement())
  EnterpriseId Int
  Name         String
  Position     Int    @default(0)

  Enterprise Enterprise  @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)
  UnitGroups UnitGroup[]

  @@index([EnterpriseId])
}

model UnitGroup {
  Id           Int      @id @default(autoincrement())
  EnterpriseId Int
  TowerId      Int?
  Name         String
  UnitNumbers  String[] @default([])

  Enterprise Enterprise @relation(fields: [EnterpriseId], references: [Id], onDelete: Cascade)
  Tower      Tower?     @relation(fields: [TowerId], references: [Id], onDelete: SetNull)

  @@index([EnterpriseId])
  @@index([TowerId])
}

// ─── Media Center ───────────────────────────────────────────────────────
//
// Biblioteca de mídia por organização, espelhando o contrato do media center
// da nk-api-customization (docs/media-center-frontend-integration.md) para que
// o front porte 1:1 e uma eventual reintegração seja troca de driver, não
// reescrita. Divergências deliberadas do contrato:
//   - OrganizationId é String (uuid): o planner tem Organization própria.
//   - Storage é Supabase (bucket público), não Azure Blob + SAS.
//   - PublicOptimizedUrl existe mas fica SEMPRE null no v0 (sem sharp; o
//     next/image já otimiza o grid). O front faz `optimized ?? public`.
//   - Sem coluna de render em BaseMaterial → FileUsagesDto.materials.asRender
//     é sempre [].

enum MediaFileStatus {
  Pending
  Active
  Deleted
}

enum MediaFileType {
  Image
  Document
}

model MediaFolder {
  Id             Int    @id @default(autoincrement())
  OrganizationId String
  ParentFolderId Int?
  Name           String
  /// Derivado do Name pelo backend (minúsculo, sem acento). Read-only.
  Slug           String
  /// 0 = raiz, máx 4 (o teto de 5 níveis é contado a partir de 1).
  Depth          Int    @default(0)

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  Organization Organization  @relation(fields: [OrganizationId], references: [id], onDelete: Cascade)
  // NoAction, não Restrict: NO ACTION é checado no fim da statement, então o
  // cascade de delete da org apaga a árvore inteira de uma vez. Restrict
  // abortaria ao remover um pai antes do filho. Um delete avulso de pasta com
  // filho ainda falha — de propósito: o store re-parenteia ANTES de excluir.
  ParentFolder MediaFolder?  @relation("FolderTree", fields: [ParentFolderId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  ChildFolders MediaFolder[] @relation("FolderTree")
  Files        MediaFile[]

  // Atenção: NÃO cobre a raiz — Postgres trata NULL como distinto, então duas
  // pastas raiz de mesmo nome passam por aqui. O store valida (e precisa
  // validar de qualquer forma, para dar erro em PT-BR em vez de P2002 cru).
  @@unique([OrganizationId, ParentFolderId, Name])
  @@index([OrganizationId, ParentFolderId])
}

model MediaFile {
  Id                 Int             @id @default(autoincrement())
  OrganizationId     String
  FolderId           Int?
  /// authUserId do Supabase (= Membership.authUserId).
  UploadedById       String
  DisplayName        String
  OriginalFilename   String
  /// "{organizationId}/{uuid}.{ext}" — não adivinhável (bucket é público).
  StoragePath        String
  /// Bucket do Supabase Storage. Paridade com o container do Azure.
  StorageContainer   String
  /// null enquanto Status = Pending.
  PublicUrl          String?
  /// Sempre null no v0 — ver nota do bloco.
  PublicOptimizedUrl String?
  MimeType           String
  FileType           MediaFileType
  SizeBytes          BigInt
  Width              Int?
  Height             Int?
  Status             MediaFileStatus @default(Pending)

  CreatedAt DateTime @default(now()) @db.Timestamptz()
  UpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  Organization Organization @relation(fields: [OrganizationId], references: [id], onDelete: Cascade)
  // SetNull: excluir pasta NUNCA apaga a linha do arquivo (o store re-parenteia
  // antes; isto é rede de segurança contra objeto órfão no bucket).
  Folder       MediaFolder? @relation(fields: [FolderId], references: [Id], onDelete: SetNull)

  // Só BaseMaterial tem imagem no Planner: imagem de ambiente e de planta é
  // assunto do Personaliza (docs/context/product.md). Por isso FileUsagesDto
  // devolve blueprints/rooms sempre vazios — os campos ficam lá só por
  // paridade com o contrato da API de customização.
  BaseMaterials BaseMaterial[] @relation("BaseMaterialPreviewMedia")

  @@unique([StorageContainer, StoragePath])
  @@index([OrganizationId, Status, FolderId])
  @@index([OrganizationId, Status, CreatedAt])
}

/// Uso de armazenamento por organização. Incrementa só na transição
/// Pending → Active do confirm; decrementa no delete.
model StorageUsage {
  Id             Int      @id @default(autoincrement())
  OrganizationId String   @unique
  UsedBytes      BigInt   @default(0)
  FileCount      Int      @default(0)
  UpdatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz()

  Organization Organization @relation(fields: [OrganizationId], references: [id], onDelete: Cascade)
}
