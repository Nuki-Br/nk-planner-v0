# ─── Supabase ────────────────────────────────────────────────────────────────
# Settings → Data API → Project URL (SEM caminho — só https://<ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Settings → API Keys → Publishable key (substitui a antiga anon key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Settings → API Keys → Secret key (substitui a service_role; NUNCA no browser).
SUPABASE_SECRET_KEY="sb_secret_..."

# ─── Database (Prisma → Supabase Postgres) ──────────────────────────────────
# Connect (topo do painel) → ORMs → Prisma. Substituir [YOUR-PASSWORD] pela
# senha do banco (Settings → Database → Reset database password se perder).
# DATABASE_URL: transaction pooler (porta 6543) para o app.
# DIRECT_URL: session pooler (porta 5432) para migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Seed do usuário de teste ────────────────────────────────────────────────
# SEED_USER_PASSWORD é necessária para o npm run db:seed provisionar o usuário
# no Supabase Auth (sem ela o seed do domínio roda, mas PULA a criação do
# usuário). Não há senha padrão no código — defina uma aqui.
# SEED_USER_EMAIL="beta@nukibr.com"
SEED_USER_PASSWORD="<defina-uma-senha>"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
